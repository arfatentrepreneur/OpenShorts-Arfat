        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $json.job_id }}\",\n  \"clip_index\": {{ $json.clip_index }},\n  \"platforms\": [\"tiktok\", \"instagram\", \"youtube\"],\n  \"scheduled_date\": \"{{ $json.scheduled_date }}\",\n  \"timezone\": \"UTC\"\n}",
        "options": {}
