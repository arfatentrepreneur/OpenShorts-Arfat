    {
      "parameters": {
        "content": "## ACT 4 \u2014 The feedback loop: learn what worked\n\nOnce a week the machine reads the analytics of everything it published (via the OpenShorts analytics API, which aggregates TikTok/Instagram/YouTube numbers) and sends you the verdict: total impressions, per-platform split, and your best post.\n\nThe machine that posts is the machine that measures \u2014 so every approval you make next week is informed by what actually landed. Close the loop further by feeding your winners back as examples in your clip prompts.",
        "height": 340,
        "width": 400,
        "color": 7
      },
      "id": "note-act4",
      "name": "Act 4 note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -560,
        1260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                0
              ],
              "triggerAtHour": 18
            }
          ]
        }
      },
      "id": "weekly-schedule",
      "name": "Every Sunday 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -80,
        1360
      ]
    },
    {
      "parameters": {
        "url": "https://api.openshorts.app/api/social/analytics/impressions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "period",
              "value": "last_week"
            },
            {
              "name": "breakdown",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "weekly-impressions",
      "name": "Weekly impressions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        1360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "OpenShorts API key"
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.openshorts.app/api/social/analytics/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus({ days: 7 }).toFormat('yyyy-MM-dd') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "weekly-posts",
      "name": "Per-post metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        1360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "OpenShorts API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Turn the two analytics responses into one human digest message.\nconst impressions = $('Weekly impressions').first().json || {};\nconst postsResp = $input.first().json || {};\nconst posts = postsResp.posts || postsResp.data || postsResp.items || [];\n\nconst views = (post) => {\n  const m = post.post_metrics || post.metrics || post;\n  return Number(m.views || m.impressions || m.plays || 0);\n};\n\nconst total = impressions.total_impressions || posts.reduce((s, p) => s + views(p), 0);\nconst sorted = [...posts].sort((a, b) => views(b) - views(a));\nconst best = sorted[0];\n\nconst perPlatform = impressions.per_platform\n  ? Object.entries(impressions.per_platform)\n      .map(([p, v]) => `  \u2022 ${p}: ${Number(v).toLocaleString('en-US')}`)\n      .join('\\n')\n  : '';\n\nlet text = `\ud83d\udcca Your week on autopilot\\n\\n`;\ntext += `Posts published: ${posts.length}\\n`;\ntext += `Total impressions: ${Number(total).toLocaleString('en-US')}\\n`;\nif (perPlatform) {\n  text += `${perPlatform}\\n`;\n}\nif (best && views(best) > 0) {\n  const title = best.title || best.caption || best.platform_post_id || 'your top post';\n  text += `\\n\ud83c\udfc6 Best post: \"${title}\" \u2014 ${views(best).toLocaleString('en-US')} views`;\n}\nif (posts.length === 0) {\n  text += `\\nNothing published this week. Approve some clips and the machine does the rest.`;\n}\nreturn [{ json: { digest: text } }];"
      },
      "id": "write-digest",
      "name": "Write the digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        1360
      ]
    },
